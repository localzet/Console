{
  "name": "localzet/console",
  "description": "Localzet Console library",
  "type": "library",
  "keywords": [
    "localzet",
    "Console"
  ],
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "role": "Developer",
      "name": "Ivan Zorin",
      "email": "creator@localzet.com",
      "homepage": "https://github.com/localzet"
    }
  ],
  "support": {
    "email": "support@localzet.com",
    "source": "https://github.com/localzet/Console"
  },
  "autoload": {
    "psr-4": {
      "localzet\\": "",
      "localzet\\Console\\": "src"
    }
  },
  "require": {
    "php": ">=8.4.1",
    "symfony/console": "^8.1.10",
    "illuminate/console": "^13.39"
  },
  "suggest": {
    "ext-zip": "For build bin",
    "ext-openssl": "For build phar (Phar::OPENSSL)"
  },
  "scripts": {
    "test": "php tests/run.php",
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "check": ["@lint", "@test"]
  }
}
